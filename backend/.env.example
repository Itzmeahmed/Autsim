# Auti AIgnosis - Environment Configuration Template
# Copy to `.env` (project root) for local use. Never commit the real .env.
# On Render, enter these under Environment instead of using a file.

# development | staging | production
ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-new-64-char-hex-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database. SQLite for local development; PostgreSQL (Neon / Supabase) when deployed.
DATABASE_URL=sqlite:///./autism.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# One-Time Password (OTP)
# MOCK_OTP_MODE=True returns the OTP in the API response (demo only, no SMS is sent).
# ENV=production requires MOCK_OTP_MODE=False and a real SMS provider.
MOCK_OTP_MODE=True
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Demo helpers (blank = on only when ENV=development)
ENABLE_DEMO_LOGIN=
SEED_DEMO_DATA=
# Used only when SEED_DEMO_DATA=False, to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS: your deployed frontend URL(s), comma-separated, no trailing slash
FRONTEND_URL=
ALLOWED_ORIGINS=
