# =====================================================================
# Auti AIgnosis - Platform Environment Configuration
# Copy to `.env` in the project root. Never commit the real .env.
# =====================================================================

# Environment mode: development | staging | production
ENV=development

# Security & Cryptography
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-new-64-char-hex-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Configuration
# Local development: SQLite
DATABASE_URL=sqlite:///./autism.db
# Deployed: Neon / Supabase PostgreSQL
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# One-Time Password (OTP) Authentication Settings
MOCK_OTP_MODE=True
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Demo helpers (blank = on only when ENV=development)
ENABLE_DEMO_LOGIN=
SEED_DEMO_DATA=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend / CORS (deployed frontend URL, no trailing slash)
FRONTEND_URL=
ALLOWED_ORIGINS=

# Logging & Clinical Audit Settings
LOG_LEVEL=INFO
AUDIT_TRAIL_ENABLED=True
