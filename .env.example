# =====================================================================
# Auti AIgnosis - Platform Environment Configuration
# =====================================================================

# Environment mode: development | staging | production
ENV=development

# Security & Cryptography
SECRET_KEY=autism-screening-clinical-platform-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Configuration
# Default: SQLite local development database
DATABASE_URL=sqlite:///./autism.db
# Production PostgreSQL connection example:
# DATABASE_URL=postgresql://autiaignosis_user:strong_password@localhost:5432/autiaignosis_db

# One-Time Password (OTP) Authentication Settings
MOCK_OTP_MODE=True
MOCK_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ML Screening Model Configuration
MODEL_DIR=ml/models
MODEL_VERSION=v1.0.0
SCREENING_CONFIDENCE_THRESHOLD=0.50

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging & Clinical Audit Settings
LOG_LEVEL=INFO
AUDIT_TRAIL_ENABLED=True
